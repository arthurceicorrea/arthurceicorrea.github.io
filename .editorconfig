# Regras de formatação para qualquer editor (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true

[*.py]
indent_size = 4

# O make exige tabulação no início de cada linha de comando.
[Makefile]
indent_style = tab

# A especificação do vCard (RFC 6350) exige fim de linha CRLF.
[*.vcf]
end_of_line = crlf
